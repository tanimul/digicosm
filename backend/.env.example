# ─── DCE Platform — Backend Environment Variables ─────────────────────────────
# Copy to .env and fill in your values. Never commit .env to git.
#
#   cp backend/.env.example backend/.env

# ─── Django Core ──────────────────────────────────────────────────────────────

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-50-char-random-string

DEBUG=True

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

DJANGO_SETTINGS_MODULE=config.settings.development

# ─── Database ─────────────────────────────────────────────────────────────────

DATABASE_URL=postgres://postgres:postgres@localhost:5432/dce_db

# ─── Redis ────────────────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379/0

# ─── CORS ─────────────────────────────────────────────────────────────────────

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── AI Key Encryption (Fernet) ───────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here

# ─── OTP / SMS (Bangladesh) ───────────────────────────────────────────────────

OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
SMS_GATEWAY_URL=https://api.smsgateway.com.bd/api/v3
SMS_GATEWAY_API_KEY=your-sms-gateway-api-key
SMS_SENDER_ID=DCE_BD

# ─── Payments ─────────────────────────────────────────────────────────────────

# bKash API
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Nagad API
NAGAD_MERCHANT_ID=your-nagad-merchant-id
NAGAD_MERCHANT_PRIVATE_KEY=your-nagad-private-key
NAGAD_BASE_URL=https://sandbox.mynagad.com:10080/remote-payment-gateway-1.0

# SSLCommerz
SSLCOMMERZ_STORE_ID=your-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=your-sslcommerz-store-password
SSLCOMMERZ_IS_SANDBOX=True

# Stripe (international fallback)
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ─── Referral System ──────────────────────────────────────────────────────────

REFERRAL_BONUS_AMOUNT=50

# ─── AWS S3 / Object Storage (optional — leave blank to use local storage) ────

USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=dce-media
# AWS_S3_REGION_NAME=ap-southeast-1

# ─── Email ────────────────────────────────────────────────────────────────────

DEFAULT_FROM_EMAIL=noreply@dce.com.bd
SERVER_EMAIL=server@dce.com.bd
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# ─── Sentry (optional) ────────────────────────────────────────────────────────

SENTRY_DSN=

# ─── Deployment ───────────────────────────────────────────────────────────────

# Used by docker-compose.prod.yml
DEPLOY_HOST=your-server-ip
DEPLOY_USER=ubuntu
GHCR_USERNAME=your-github-username
